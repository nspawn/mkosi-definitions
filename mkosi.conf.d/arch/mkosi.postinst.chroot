#!/bin/sh
set -e
# make sure systemd-networkd and systemd-resolved are running
systemctl enable systemd-networkd
systemctl enable systemd-resolved
# make sure we symlink /run/systemd/resolve/stub-resolv.conf to /etc/resolv.conf
# otherwise curl will fail
ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
# pacman-mirrorlist ships every mirror commented out, which leaves pacman with no server
# to talk to. The geo mirror is what the official container image uses.
echo 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch' > /etc/pacman.d/mirrorlist
# mkosi verifies packages with a pacman keyring it keeps in its sandbox, not in the image,
# and the image ships none either: pacman-key --init makes a local master key, private
# half included, and every machine pulled from the image would share it, so anyone with
# the image could certify a key that all of those machines trust. pacman-init.service
# makes each machine's own keyring on its first boot instead.
rm -rf /etc/pacman.d/gnupg
# Add pts/[0-4] to /etc/securetty to allow logins via `machinectl login`
{
  echo "pts/0"
  echo "pts/1"
  echo "pts/2"
  echo "pts/3"
  echo "pts/4"
} >>/etc/securetty

#!/bin/sh
set -e
systemctl enable redis-server
# Listen on every address; Debian's default is localhost only, and protected mode would
# then refuse every client from the network. Set requirepass in /etc/redis/redis.conf
# before publishing the port to the outside.
sed -i -e 's/^bind 127.0.0.1 -::1$/bind 0.0.0.0 -::/' -e 's/^protected-mode yes$/protected-mode no/' /etc/redis/redis.conf

#!/bin/sh
set -e
systemctl enable smbd
# One share to start with, writable by guests, on a directory to mount from the host
# (-v /srv/files:/srv/samba/data); printing is off, this is not a print server.
mkdir -p /srv/samba/data
chown nobody:nogroup /srv/samba/data
printf '%s\n' '[global]' \
    '   workgroup = WORKGROUP' \
    '   server string = Samba on nspawn' \
    '   server role = standalone server' \
    '   map to guest = Bad User' \
    '   load printers = no' \
    '   printing = bsd' \
    '   printcap name = /dev/null' \
    '   disable spoolss = yes' \
    '   log file = /var/log/samba/log.%m' \
    '   max log size = 1000' \
    '' \
    '[data]' \
    '   path = /srv/samba/data' \
    '   browseable = yes' \
    '   read only = no' \
    '   guest ok = yes' \
    '   force user = nobody' > /etc/samba/smb.conf

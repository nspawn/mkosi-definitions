# Generated host keys on the first boot of every machine. The image ships none, so that
# two machines pulled from it do not share keys.
[Unit]
Description=Generate the SSH host keys
Before=ssh.service
ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -A

[Install]
WantedBy=multi-user.target

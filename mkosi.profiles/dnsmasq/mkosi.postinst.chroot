#!/bin/sh
set -e
systemctl enable dnsmasq
# Debian's init helper sees the resolvconf shim that systemd-resolved ships and waits for
# it to write /run/dnsmasq/resolv.conf, which never happens: dnsmasq would run without
# upstream servers and answer REFUSED. Point it at the servers resolved learned instead.
printf 'RESOLV_CONF=/run/systemd/resolve/resolv.conf\nIGNORE_RESOLVCONF=yes\n' >> /etc/default/dnsmasq
# A DNS server owns port 53: systemd-resolved must not run its stub listener, and the
# machine's own lookups go to the upstream servers resolved learned from the bridge.
mkdir -p /etc/systemd/resolved.conf.d
printf '[Resolve]\nDNSStubListener=no\n' > /etc/systemd/resolved.conf.d/nspawn.conf
ln -sf /run/systemd/resolve/resolv.conf /etc/resolv.conf
